# ═══════════════════════════════════
# ربات
# ═══════════════════════════════════

# توکن ربات
BOT_TOKEN=
# متن دولوپر
ASLICODE_TEXT=Coded by AsliCode
ASLICODE_TEXTS=Coded by @AsliCode
DEBUG=false
# ایدی عددی مدیر اصلی ربات
ADMIN_ID=8263673526

# ═══════════════════════════════════
# درگاه پرداخت (Tetraminator)
# ═══════════════════════════════════

# توکن درگاه پرداخت تترامیناتور
TETRAMINATOR_API_KEY=
# URL BASE تترامینانور
TETRAMINATOR_BASE_URL=https://example.com

# ═══════════════════════════════════
# محدوده شارژ (تومان)
# ═══════════════════════════════════

# حداقل شارژ تومان
CHARGE_MIN=50000
# حداکثر شارژ تومان
CHARGE_MAX=10000000
# مبالغ شارژ آماده دلار
QUICK_AMOUNTS=1,5,10,50

# ═══════════════════════════════════
# جوین اجباری
# ═══════════════════════════════════

# فعال بودن جوین اجباری true غیرفعال بودن false
FORCE_JOIN_ENABLED=true
# نام نمایشی چنل جوین اجباری
FORCE_JOIN_CHANNEL=@example
# لینک کانال یا گروه جوین اجباری
FORCE_JOIN_CHANNEL_URL=https://t.me/example

# ═══════════════════════════════════
# نرخ دلار
# ═══════════════════════════════════

# آدرس سایت برای دریافت لحظه‌ای قیمت دلار برای محاسبه
DOLLAR_RATE_API=https://api.priceto.day/v1/latest/irr/usd
# درصد سود
DOLLAR_RATE_MARGIN=5.0
DOLLAR_RATE_CACHE=30

# ═══════════════════════════════════
# وب‌هوک درگاه‌ها
# ═══════════════════════════════════

# پورت وب‌هوک سرور
WEBHOOK_PORT=8080
# آدرس پایه برای callback (IP یا دامنه سرور)
WEBHOOK_BASE_URL=http://YOUR_SERVER:8080